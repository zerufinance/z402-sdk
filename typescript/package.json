{
  "name": "zeru-z402",
  "version": "0.1.0",
  "description": "Before an x402 agent pays a wallet, ask zScreen: PAY or DON'T PAY. Buyer guard and seller guard for x402.",
  "license": "Apache-2.0",
  "author": "Zeru AI",
  "homepage": "https://github.com/zerufinance/z402-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zerufinance/z402-sdk.git",
    "directory": "typescript"
  },
  "bugs": {
    "url": "https://github.com/zerufinance/z402-sdk/issues"
  },
  "keywords": [
    "x402",
    "payments",
    "agents",
    "wallet",
    "screening",
    "sanctions",
    "compliance",
    "zscreen",
    "usdc"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test --test-concurrency=1 test/guard.test.mjs",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@x402/core": ">=2.3.0 <3"
  },
  "devDependencies": {
    "@x402/axios": "2.31.0",
    "@x402/core": "2.31.0",
    "@x402/evm": "2.31.0",
    "@x402/fetch": "2.31.0",
    "axios": "1.20.0",
    "typescript": "5.9.3",
    "viem": "2.57.4"
  }
}
